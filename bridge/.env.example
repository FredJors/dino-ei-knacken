# ------------------------------------------------------------
# Dino-Ei-Bridge – Einstellungen
# Diese Datei nach ".env" kopieren und anpassen.
# ------------------------------------------------------------

# TikTok-Benutzername (ohne @), dessen LIVE gelesen werden soll
TIKTOK_USERNAME=dein_tiktok_name

# Port für Spiel + WebSocket (Standard 8787)
PORT=8787

# Optional: API-Key für den Signatur-Server (Euler Stream) – nur nötig,
# wenn die Bridge "Rate-Limit" meldet. Leer lassen = ohne Key.
SIGN_API_KEY=

# Wie oft (Sekunden) neu versucht wird, solange du nicht live bist
OFFLINE_RETRY_SEC=30

# Log-Datei unter bridge/logs/ schreiben (1 = ja, 0 = nein)
LOG_FILE=1

# Optional: zusätzliche erlaubte Web-Adressen (Origins), komma-getrennt.
# localhost, file:// und *.github.io sind immer erlaubt.
ALLOWED_ORIGINS=

# Demo-Modus: Events pro Sekunde (nur bei "npm run demo")
DEMO_RATE=2
